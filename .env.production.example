# Copy to .env.production on the VPS and fill in real values.
# This file is safe to commit because it contains no secrets.

NODE_ENV=production
DB_TYPE=neon
DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.example.com/api/auth
NEXT_PUBLIC_BETTER_AUTH_URL=https://api.example.com

CLIENT_URL=https://example.com
FRONTEND_URL=https://example.com
NEXT_PUBLIC_BACKEND_URL=https://api.example.com

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=

NEXT_PUBLIC_COMMISSION_AMOUNT=10
NEXT_PUBLIC_IMAGE_LIMIT=20

# Optional media/S3/R2 settings used by the web app upload routes.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
