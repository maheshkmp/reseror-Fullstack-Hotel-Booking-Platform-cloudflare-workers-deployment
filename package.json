{
  "name": "bunplate",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.2.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "better-auth": "^1.4.18",
      "hono": "^4.10.7"
    }
  },
  "scripts": {
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "db:generate": "bun run --filter core db:generate",
    "db:push": "bun run --filter core db:push",
    "db:migrate": "bun run --filter core db:migrate",
    "db:studio": "bun run --filter core db:studio"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@types/bun": "latest",
    "core": "workspace:*",
    "wrangler": "^3.109.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "zod": "^4.3.6"
  }
}